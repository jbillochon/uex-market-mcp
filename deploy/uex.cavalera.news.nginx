# uex.cavalera.news - public MCP connector for UEX marketplace search.
# Proxies only /mcp and /health to 127.0.0.1:8792; everything else is 404,
# / redirects to the project page.
server {
    listen 80;
    listen [::]:80;
    server_name uex.cavalera.news;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        try_files $uri =404;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name uex.cavalera.news;

    ssl_certificate /etc/letsencrypt/live/uex.cavalera.news/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/uex.cavalera.news/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include /etc/nginx/snippets/cavalera-securite.conf;
    access_log /var/log/nginx/uexmcp.log;
    client_max_body_size 64k;

    location = /mcp {
        limit_req zone=uexmcp burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8792/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
    location = /health {
        limit_req zone=uexmcp burst=20 nodelay;
        proxy_pass http://127.0.0.1:8792/health;
        proxy_set_header Host $host;
    }
    location = / {
        return 302 https://github.com/jbillochon/uex-market-mcp;
    }
    location / {
        return 404;
    }
}
